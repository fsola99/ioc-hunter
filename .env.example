# Copy to .env and fill in. .env is gitignored — keys never belong in the repo.

# Required. Free key from https://www.virustotal.com/gui/my-apikey
# Free tier: 4 lookups/minute, 500/day.
VT_API_KEY=

# Optional. Adds reporting history to IP reports.
# Free key from https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# How long a provider response stays servable from cache, in seconds.
CACHE_TTL_SECONDS=900
